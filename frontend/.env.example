# =================================
# EJEMPLO DE FRONTEND (frontend/.env.example)
# (Las variables de Vite DEBEN empezar con VITE_)
# =================================

# URL del backend (para desarrollo local)
VITE_API_URL="http://localhost:3001/api"

# Llave pública de Stripe (esta es segura de compartir, pero mejor usar la de prueba)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# NOTA PARA PRODUCCIÓN:
# En producción (ej. Vercel), la VITE_API_URL deberá ser
# la URL de tu backend desplegado (ej. https://api.driverautomanager.com/api)