# ================================
# EJEMPLO DE BACKEND (backend/.env.example)
# ================================

# --- General ---
NODE_ENV="development"
PORT="3001"

# --- Seguridad ---
# (Usa un generador de contraseñas largo y aleatorio para esto)
JWT_SECRET="TU_JWT_SECRET_LARGO_Y_ALEATORIO_AQUI"

# (URLs del frontend que pueden conectarse, separadas por comas)
ALLOWED_ORIGINS="http://localhost:5173"

# --- Base de Datos (PostgreSQL) ---
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="lups"
DB_PASSWORD="POSTGRES"
DB_DATABASE="auto_manager_db"

# (Opcional: si usas una URL de conexión única para producción, ej. Railway)
# DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:PUERTO/DB_NOMBRE"

# --- Cloudinary (Almacenamiento de Fotos) ---
CLOUDINARY_CLOUD_NAME="TU_CLOUD_NAME"
CLOUDINARY_API_KEY="TU_API_KEY"
CLOUDINARY_API_SECRET="TU_API_SECRET"

# --- Stripe (Pasarela de Pagos) ---
STRIPE_SECRET_KEY="sk_live_... O sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_live_... O pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

#--- Configuracion de correos
SMTP_HOST="smtp.gmail.com" #-- De preferiancia servicio GMAIL
SMTP_PORT="587"
SMTP_USER="correo@gmail.com"
SMTP_PASS="contraseña de aplicacion"
#--- para gmail activa el 2FA y crea un contraseña de aplicacion (Aparece la opciones despues de activar 2FA)
SMTP_SECURE="false"

